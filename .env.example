# Porta exposta pelo container e pelo servidor
PORT=3000

# Caminho do banco de dados SQLite (dentro do container o volume é montado em /app/data)
DATABASE_URL=/app/data/stublab.db

# Nível de log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Ambiente de execução
NODE_ENV=production

# ─── Postgres (apenas para docker-compose.prod.yml — não implementado ainda) ──
# POSTGRES_USER=stublab
# POSTGRES_PASSWORD=stublab
# POSTGRES_DB=stublab

# ─── Variáveis não implementadas nesta versão ─────────────────────────────────
# UI_PORT e MOCK_PORT não são suportados. Todo tráfego usa PORT (porta única).
# UI_PORT=3001
# MOCK_PORT=3002

# ─── Proxy Mode ─────────────────────────────────────────────────────────────
# Permite desativar proxy globalmente (útil para CI offline)
PROXY_ENABLED=true

# Timeout em ms para chamadas ao serviço real
PROXY_TIMEOUT_MS=10000
