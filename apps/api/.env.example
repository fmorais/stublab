# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ─── Banco de dados ───────────────────────────────────────────────────────────
# Em dev o arquivo fica em apps/api/stublab.db (criado automaticamente)
DATABASE_URL=./stublab.db

# ─── Proxy Mode ──────────────────────────────────────────────────────────────
# Permite desativar proxy globalmente (útil para CI offline)
PROXY_ENABLED=true

# Timeout em ms para chamadas ao serviço real
PROXY_TIMEOUT_MS=10000
